{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kj-9/uv-packsize/schemas/analysis-result-v3.schema.json",
  "title": "uv-packsize project-lock analysis result v3", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "measurement", "context", "distributions", "warnings", "duplicate_ownerships", "completeness", "totals"],
  "properties": {"schema_version": {"const": 3}, "measurement": {"$ref": "#/$defs/measurement"}, "context": {"$ref": "#/$defs/context"}, "distributions": {"type": "array", "items": {"$ref": "#/$defs/distribution"}}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}, "duplicate_ownerships": {"type": "array", "items": {"$ref": "#/$defs/duplicateOwnership"}}, "completeness": {"enum": ["complete", "incomplete"]}, "totals": {"$ref": "#/$defs/rootTotals"}},
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[-_.]+[A-Za-z0-9]+)*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000).+$"},
    "safeObservation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"}, "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["kind", "unit", "ownership", "deduplication"], "properties": {"kind": {"const": "installed-logical-size"}, "unit": {"const": "bytes"}, "ownership": {"const": "distribution-owned-files"}, "deduplication": {"const": "canonical-identity"}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["input_kind", "root_package", "workspace_member", "dependency_group_selection", "dependency_groups", "extras", "python_version", "platform", "architecture", "path_flavor", "case_rule", "uv_version", "build_policy", "compile_bytecode", "resolution_strategy", "lock_identity"], "properties": {"input_kind": {"const": "project-lock"}, "root_package": {"$ref": "#/$defs/name"}, "workspace_member": {"anyOf": [{"$ref": "#/$defs/name"}, {"type": "null"}]}, "dependency_group_selection": {"enum": ["none", "explicit", "all"]}, "dependency_groups": {"type": "array", "items": {"$ref": "#/$defs/name"}, "uniqueItems": true}, "extras": {"type": "array", "items": {"$ref": "#/$defs/name"}, "uniqueItems": true}, "python_version": {"$ref": "#/$defs/safeObservation"}, "platform": {"$ref": "#/$defs/safeObservation"}, "architecture": {"$ref": "#/$defs/safeObservation"}, "path_flavor": {"enum": ["posix", "windows"]}, "case_rule": {"enum": ["sensitive", "insensitive"]}, "uv_version": {"$ref": "#/$defs/safeObservation"}, "build_policy": {"enum": ["wheel-only", "allow-build"]}, "compile_bytecode": {"type": "boolean"}, "resolution_strategy": {"$ref": "#/$defs/safeObservation"}, "lock_identity": {"$ref": "#/$defs/fingerprint"}}, "allOf": [{"if": {"properties": {"dependency_group_selection": {"const": "none"}}}, "then": {"properties": {"dependency_groups": {"maxItems": 0}}}}, {"if": {"properties": {"dependency_group_selection": {"const": "explicit"}}}, "then": {"properties": {"dependency_groups": {"minItems": 1}}}}]},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "canonical_identity", "logical_bytes", "category", "origin", "is_symlink"], "properties": {"path": {"$ref": "#/$defs/path"}, "canonical_identity": {"$ref": "#/$defs/path"}, "logical_bytes": {"type": "integer", "minimum": 0}, "category": {"enum": ["python", "native", "data", "metadata", "script", "other"]}, "origin": {"enum": ["record", "generated", "fallback", "discovered"]}, "is_symlink": {"type": "boolean"}}},
    "warning": {"type": "object", "additionalProperties": false, "required": ["code", "target_kind", "target_identity"], "properties": {"code": {"enum": ["duplicate-ownership", "duplicate-record-entry", "filesystem-error", "filesystem-layout-error", "invalid-record", "invalid-record-path", "invalid-metadata", "missing-file", "missing-metadata", "missing-record", "missing-record-self-entry", "record-path-outside-prefix", "unsupported-file-type"]}, "target_kind": {"enum": ["distribution", "file"]}, "target_identity": {"type": "string", "minLength": 1}}},
    "totals": {"type": "object", "additionalProperties": false, "required": ["logical_bytes"], "properties": {"logical_bytes": {"type": "integer", "minimum": 0}}},
    "distribution": {"type": "object", "additionalProperties": false, "required": ["name", "version", "files", "warnings", "completeness", "totals"], "properties": {"name": {"$ref": "#/$defs/name"}, "version": {"type": "string", "minLength": 1}, "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}, "completeness": {"enum": ["complete", "incomplete"]}, "totals": {"$ref": "#/$defs/totals"}}},
    "duplicateOwnership": {"type": "object", "additionalProperties": false, "required": ["canonical_identity", "owners"], "properties": {"canonical_identity": {"$ref": "#/$defs/path"}, "owners": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/name"}, "uniqueItems": true}}},
    "rootTotals": {"type": "object", "additionalProperties": false, "required": ["global_logical_bytes", "distribution_logical_bytes"], "properties": {"global_logical_bytes": {"type": "integer", "minimum": 0}, "distribution_logical_bytes": {"type": "integer", "minimum": 0}}}
  }
}
