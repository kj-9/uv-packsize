{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/kj-9/uv-packsize/schemas/comparison-result-v2.schema.json", "title": "uv-packsize project-lock comparison result v2", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "measurement", "context", "baseline", "current", "changes", "completeness"],
  "properties": {"schema_version": {"const": 2}, "measurement": {"$ref": "#/$defs/measurement"}, "context": {"$ref": "#/$defs/context"}, "baseline": {"$ref": "#/$defs/side"}, "current": {"$ref": "#/$defs/side"}, "changes": {"$ref": "#/$defs/changes"}, "completeness": {"$ref": "#/$defs/completeness"}},
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "completeness": {"enum": ["complete", "incomplete"]},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["kind", "unit", "ownership", "deduplication"], "properties": {"kind": {"const": "installed-logical-size"}, "unit": {"const": "bytes"}, "ownership": {"const": "distribution-owned-files"}, "deduplication": {"const": "canonical-identity"}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["input_kind", "comparison_context_fingerprint", "lock_changed"], "properties": {"input_kind": {"const": "project-lock"}, "comparison_context_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "lock_changed": {"type": "boolean"}}},
    "nonnegativeInteger": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, "signedInteger": {"type": "integer", "minimum": -9223372036854775807, "maximum": 9223372036854775807}, "nonreconciliationInteger": {"type": "integer", "minimum": -18446744073709551614, "maximum": 18446744073709551614},
    "warningCodeCount": {"type": "object", "additionalProperties": false, "required": ["code", "count"], "properties": {"code": {"enum": ["duplicate-ownership", "duplicate-record-entry", "filesystem-error", "filesystem-layout-error", "invalid-record", "invalid-record-path", "invalid-metadata", "missing-file", "missing-metadata", "missing-record", "missing-record-self-entry", "record-path-outside-prefix", "unsupported-file-type"]}, "count": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}}},
    "duplicateOwnership": {"type": "object", "additionalProperties": false, "required": ["present", "count"], "properties": {"present": {"type": "boolean"}, "count": {"$ref": "#/$defs/nonnegativeInteger"}}, "allOf": [{"if": {"properties": {"present": {"const": true}}}, "then": {"properties": {"count": {"minimum": 1}}}}, {"if": {"properties": {"present": {"const": false}}}, "then": {"properties": {"count": {"const": 0}}}}]},
    "totals": {"type": "object", "additionalProperties": false, "required": ["global_logical_bytes", "distribution_logical_bytes"], "properties": {"global_logical_bytes": {"$ref": "#/$defs/nonnegativeInteger"}, "distribution_logical_bytes": {"type": "integer", "minimum": 0}}},
    "side": {"type": "object", "additionalProperties": false, "required": ["totals", "completeness", "warning_code_counts", "duplicate_ownership"], "properties": {"totals": {"$ref": "#/$defs/totals"}, "completeness": {"$ref": "#/$defs/completeness"}, "warning_code_counts": {"type": "array", "items": {"$ref": "#/$defs/warningCodeCount"}}, "duplicate_ownership": {"$ref": "#/$defs/duplicateOwnership"}}, "allOf": [{"contains": {"properties": {"code": {"const": "duplicate-ownership"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "duplicate-record-entry"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "filesystem-error"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "filesystem-layout-error"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "invalid-record"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "invalid-record-path"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "invalid-metadata"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "missing-file"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "missing-metadata"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "missing-record"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "missing-record-self-entry"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "record-path-outside-prefix"}}}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"code": {"const": "unsupported-file-type"}}}, "minContains": 0, "maxContains": 1}]},
    "distributionSide": {"type": "object", "additionalProperties": false, "required": ["version", "logical_bytes"], "properties": {"version": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}, "logical_bytes": {"$ref": "#/$defs/nonnegativeInteger"}}},
    "distributionBase": {"type": "object", "additionalProperties": false, "required": ["name", "kind", "baseline", "current", "logical_bytes_delta"], "properties": {"name": {"$ref": "#/$defs/name"}, "kind": {"enum": ["added", "removed", "version-changed", "unchanged"]}, "baseline": {"anyOf": [{"$ref": "#/$defs/distributionSide"}, {"type": "null"}]}, "current": {"anyOf": [{"$ref": "#/$defs/distributionSide"}, {"type": "null"}]}, "logical_bytes_delta": {"$ref": "#/$defs/signedInteger"}}},
    "distribution": {"oneOf": [{"allOf": [{"$ref": "#/$defs/distributionBase"}, {"properties": {"kind": {"const": "added"}, "baseline": {"type": "null"}, "current": {"$ref": "#/$defs/distributionSide"}}}]}, {"allOf": [{"$ref": "#/$defs/distributionBase"}, {"properties": {"kind": {"const": "removed"}, "baseline": {"$ref": "#/$defs/distributionSide"}, "current": {"type": "null"}}}]}, {"allOf": [{"$ref": "#/$defs/distributionBase"}, {"properties": {"kind": {"enum": ["version-changed", "unchanged"]}, "baseline": {"$ref": "#/$defs/distributionSide"}, "current": {"$ref": "#/$defs/distributionSide"}}}]}]},
    "changeTotals": {"type": "object", "additionalProperties": false, "required": ["global_logical_bytes_delta", "distribution_logical_bytes_delta"], "properties": {"global_logical_bytes_delta": {"$ref": "#/$defs/signedInteger"}, "distribution_logical_bytes_delta": {"$ref": "#/$defs/signedInteger"}}},
    "nonreconciliation": {"type": "object", "additionalProperties": false, "required": ["present", "distribution_minus_global_logical_bytes_delta", "reason"], "properties": {"present": {"type": "boolean"}, "distribution_minus_global_logical_bytes_delta": {"$ref": "#/$defs/nonreconciliationInteger"}, "reason": {"anyOf": [{"const": "duplicate-owned-files-may-be-counted-per-distribution"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"present": {"const": true}}}, "then": {"properties": {"distribution_minus_global_logical_bytes_delta": {"not": {"const": 0}}, "reason": {"const": "duplicate-owned-files-may-be-counted-per-distribution"}}}}, {"if": {"properties": {"present": {"const": false}}}, "then": {"properties": {"distribution_minus_global_logical_bytes_delta": {"const": 0}, "reason": {"type": "null"}}}}]},
    "changes": {"type": "object", "additionalProperties": false, "required": ["totals", "distributions", "nonreconciliation"], "properties": {"totals": {"$ref": "#/$defs/changeTotals"}, "distributions": {"type": "array", "items": {"$ref": "#/$defs/distribution"}}, "nonreconciliation": {"$ref": "#/$defs/nonreconciliation"}}}
  }
}
